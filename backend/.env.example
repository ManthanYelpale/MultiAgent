# Copy to .env and fill in real values. NEVER commit .env.

# Postgres connection (application role — full read/write)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_business_os

# Restricted connection used ONLY by the natural-language SQL agent.
# Provision with:  psql -U postgres -d <db> -v db_name=<db> \
#                       -v ai_password="'<strong-password>'" \
#                       -f scripts/create_readonly_role.sql
# Leave empty to disable the SQL agent. It will NOT fall back to DATABASE_URL.
READONLY_DATABASE_URL=

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. The app refuses to start in production if this is
# left at a placeholder value — anyone who has seen this file could otherwise forge
# a token for any user.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 1440 mins = 24 hours (1 day)

# App
ENVIRONMENT=development
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Groq LLM
# Note: dataset summary statistics and document excerpts are sent to Groq for
# inference. Disclose this to your users.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
